<Window x:Class="FileCounter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileCounter"
        mc:Ignorable="d"
        Title="MainWindow" Height="850" Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20px"/>
            <RowDefinition Height="10*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Menu>
            <MenuItem Header="File">
                <MenuItem Header="Load Folder..." Click="LoadFolder_Click"/>
                <MenuItem Header="Print Output..." Click="PrintOutput_Click"/>
                <Separator/>
                <MenuItem Header="Recent Files" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="Save Structure..."/>
                <MenuItem Header="Load Structure..."/>
            </MenuItem>
        </Menu>
        <TreeView Grid.Row="1" x:Name="FolderTree"/>
        <DockPanel Grid.Row="2">
            <Button Click="PrintOutput_Click" DockPanel.Dock="Top">Print Output</Button>
            <Button DockPanel.Dock="Right">Open Output</Button>
            <Button DockPanel.Dock="Left">Open Raw Output</Button>
        </DockPanel>

    </Grid>
</Window>
